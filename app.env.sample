# Rallly — environment variable reference
# Copy relevant lines to a .env file alongside docker-compose.yaml

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=${HOSTNAME}
BASE_DOMAIN_NAME=example.com

# Application secret (min 32 chars)
APP_SECRET_KEY=changeme_secret_key_min_32_chars

# Support / admin email
APP_ADMIN_USER=admin@example.com

# Database
DB_CREATE_DATABASE_NAME=rallly
DB_USER_NAME=rallly
DB_USER_PASS=changeme_db_password

# Email / SMTP
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASS=
EMAIL_SERVER_MAIL_FROM=noreply@example.com

# Hide marketing landing page
DISABLE_LANDING_PAGE=true
