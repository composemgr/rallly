# Rallly — environment variable reference
# Copy this file to app.env and adjust as needed.

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=rallly.example.com
BASE_DOMAIN_NAME=example.com

# Session and invite token signing secret
APP_SECRET_KEY=replace-with-a-random-32-character-secret

# Database
DB_CREATE_DATABASE_NAME=rallly
DB_USER_NAME=rallly
DB_USER_PASS=replace-with-a-random-password

# Outbound email for invitations
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_LOGIN_NAME=
EMAIL_SERVER_LOGIN_PASS=
EMAIL_SERVER_MAIL_FROM=no-reply@example.com
